<?xml version="1.0" encoding="utf-8"?>
<!-- HERMES: fdroid-flavor resource overlay. Overrides upstream app_name without editing
     app/src/main/res/values/strings.xml (zero upstream file modifications).

     Upstream defines app_name in the default values/ plus 11 locale folders. A flavor overlay in
     values/ alone only wins for locales that have NO upstream override, so every upstream locale
     needs a matching overlay entry or the launcher falls back to "Agora" there. This file carries
     the full set; upstream stays untouched. -->
<resources>
    <string name="app_name">Hermes</string>
    <!-- HERMES: autopilot Adaptation History page (Hermes-only strings; the fdroid overlay keeps
         upstream app/src/main/res/values/strings.xml untouched). -->
    <string name="hermes_adaptation_history">Adaptation History</string>
    <string name="hermes_adaptation_history_desc">Review and undo memory changes made by Hermes</string>
    <string name="hermes_adaptation_history_empty">No adaptations yet. Hermes records every memory change here, with a one-tap undo.</string>
    <string name="hermes_autopilot">Autopilot</string>
    <string name="hermes_autopilot_desc">Hermes updates saved memory automatically after conversations</string>
    <string name="hermes_autopilot_cap">Daily cap: %1$d adaptations</string>
    <string name="hermes_autopilot_run_now">Run reflection now</string>
</resources>
