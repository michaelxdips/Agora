<?xml version="1.0" encoding="utf-8"?>
<!-- HERMES: play-flavor resource overlay, Hermes-only strings.

     These live in the FLAVOR overlays, not in main/res/values, on purpose: upstream's
     SettingsResourceContractTest asserts every locale directory under main/res carries every key
     defined in main/res/values. Adding 30 English-only Hermes strings to main would demand 11
     locale translations that do not exist and should not (the autopilot/persona/watch UI is
     English-only for now). Flavor overlays are outside that contract and are upstream-empty paths,
     so both flavors carry one identical copy and neither can drift.

     `app_name` also stays here (see the separate note at the top of this file). -->
<resources>
    <string name="app_name">Hermes</string>

    <!-- Adaptation History (Phase 4) -->
    <string name="hermes_adaptation_history">Adaptation History</string>
    <string name="hermes_adaptation_history_desc">Review and undo memory changes made by Hermes</string>
    <string name="hermes_adaptation_history_empty">No adaptations yet. Hermes records every memory change here, with a one-tap undo.</string>

    <!-- Autopilot controls (Phase 3) -->
    <string name="hermes_autopilot">Autopilot</string>
    <string name="hermes_autopilot_desc">Hermes updates saved memory automatically after conversations</string>
    <string name="hermes_autopilot_cap">Daily cap: %1$d adaptations</string>
    <string name="hermes_autopilot_run_now">Run reflection now</string>

    <!-- Persona system (Phase 6) -->
    <string name="hermes_personas">Personas</string>
    <string name="hermes_personas_desc">Caveman controls form (terse prose), Ponytail controls judgment (the laziest sufficient solution). Both are injected through your active memory, so they can be removed without a trace.</string>
    <string name="hermes_persona_status_active">Active — block present in active memory</string>
    <string name="hermes_persona_status_inactive">Off — no block in active memory</string>
    <string name="hermes_persona_edit">Edit text</string>
    <string name="hermes_persona_reset">Reset to default</string>
    <string name="hermes_persona_channel">Injection channel: active_memory.md (%1$d characters)</string>
    <string name="hermes_persona_store_clean">No persona markers in the store — toggle off is complete.</string>
    <string name="hermes_persona_store_dirty">Persona markers present in the store.</string>
    <string name="hermes_persona_check_updates">Check for persona updates</string>
    <string name="hermes_persona_edit_label">Rule text</string>
    <string name="hermes_persona_save">Save</string>
    <string name="hermes_persona_cancel">Cancel</string>

    <!-- Watch setup (Phase 7) -->
    <string name="hermes_watch_setup">Watch setup</string>
    <string name="hermes_watch_setup_desc">Send the provider URL, API key and model to the paired watch once. The watch then works standalone — it does not need this phone to answer.</string>
    <string name="hermes_watch_connected">Watches connected: %1$d</string>
    <string name="hermes_watch_base_url">Base URL</string>
    <string name="hermes_watch_model">Model</string>
    <string name="hermes_watch_send">Send to watch</string>
    <string name="hermes_watch_pushed">Sent. The watch is standalone now.</string>
    <string name="hermes_watch_config_only">Config sent; the memory snapshot will follow when the watch is reachable.</string>
    <string name="hermes_watch_push_failed">No watch reachable — open the app on the watch and try again.</string>
    <string name="hermes_watch_no_key">No API key configured for the selected model. Set it in Providers first.</string>
</resources>
